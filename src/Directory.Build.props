<Project>

  <!-- Wspolne ustawienia dla wszystkich projektow w src.
       Zmiana wersji .NET to jedna linia tutaj, a nie edycja kazdego .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
