@page "/customers/edit/{Id:int}"
@rendermode InteractiveWebAssembly

@inject ICustomerRepository Repository

<h3>Edit Customer #@Id</h3>


@if (customer is null)
{
    <MessageComponent Message="Customer loading..." />
}
else
{
    <EditForm Model="customer" OnValidSubmit="@HandleSave" FormName="customerForm">

        <label for="customerName" class="form-label">Name</label>
        <InputText id="customerName" @bind-Value="customer.Name" class="form-control" /> 

        <label for="Email" class="form-label">Email</label>
        <InputText id="Email" @bind-Value="customer.Email"   class="form-control"
        /> 

        <InputCheckbox id="IsDeleted" @bind-Value="customer.IsDeleted" />

        <button type="submit" class="btn btn-primary" >Save</button>

    </EditForm>
       
    <h3>@customer.Name</h3>
}

@code {

    [Parameter]
    public int Id { get; set; }

    private Customer? customer;

    protected override async Task OnParametersSetAsync()
    {
        customer = await Repository.GetByIdAsync(Id);
    }

    private async Task HandleSave()
    {
        Console.WriteLine(customer);
    }

}
