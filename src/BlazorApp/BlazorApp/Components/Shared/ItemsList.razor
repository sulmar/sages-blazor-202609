@typeparam TItem

<ul>
    @foreach (var item in Items)
    {       
        @ItemTemplate(item)        
    }
</ul>

@code {


    [Parameter, EditorRequired]
    public IEnumerable<TItem> Items { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<TItem> ItemTemplate { get; set; }

}
