@page "/"
@using Domain.Abstractions
@inject ICustomerRepository Repository
@rendermode InteractiveServer

<h3>Customers</h3>

@if (customers == null)
{
    <MessageComponent Message="Loading customers..." />
}
else
{
    <ul>
        @foreach (var customer in customers)
        {
            <li>@customer.Name @customer.Email</li>
        }
    </ul>
}


