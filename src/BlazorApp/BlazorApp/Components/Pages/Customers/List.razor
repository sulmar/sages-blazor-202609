@page "/"
@inject ICustomerRepository Repository
@rendermode InteractiveServer

<HeaderComponent Title="Customer List" />

<CustomersLoader Customers="@customers" Context="loaderContext">
    <Loading>
        <MessageComponent Message="Loading customers..." />
    </Loading>

    <Loaded>
       @*  <CustomersTable Customers="@loaderContext" Context="customer">
            <HeaderTemplate>
                <tr>
                    <th>Nazwa</th>
