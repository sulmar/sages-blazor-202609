@page "/"
@inject ICustomerRepository Repository
@inject CascadingValueSource<Profile> ProfileSource
@rendermode InteractiveServer


@* <HeaderComponent Title="Customer List" /> *@


<button class="btn btn-secondary" @onclick=ToggleTheme>Toggle Theme</button>


<h3>Customer List</h3>

<CascadingValue Value="@Status" Name="b">

    

        
        <CustomersLoader Customers="@customers" Context="loaderContext">
            <Loading>
                <MessageComponent Message="Loading customers..." />
            </Loading>

            <Loaded>
                <SearchPanel ValueChanged="SearchCustomersAsync" />

                <CustomersTable Customers="@loaderContext" Context="customer">
                    <HeaderTemplate>
                        <tr>
                            <th>Nazwa</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </HeaderTemplate>

                    <RowTemplate>
                        <tr>
                            <td>@customer.Name</td>
                            <td>@customer.Email</td>
                            <td>
                                <button class="btn btn-primary">Edit</button>
                                <button class="btn btn-danger" @onclick="() => DeleteCustomerAsync(customer)">Delete</button>
                            </td>
                        </tr>
                    </RowTemplate>
                </CustomersTable>


      

                @*  <CustomersList Customers="@customers" /> *@
            </Loaded>
        </CustomersLoader>
    </CascadingValue>





@code {

    private string Theme { get; set; } = "light";
    private string Status { get; set; } = "success";


    private async Task ToggleTheme()
    {
        Theme = Theme == "light" ? "dark" : "light";
        Profile.Theme = Theme;

        await ProfileSource.NotifyChangedAsync();
    }

    [CascadingParameter]
    public Profile Profile { get; set; }



    private string searchText = "abc";

    private IEnumerable<Customer>? customers;

    protected override async Task OnInitializedAsync()
    {
        customers = await Repository.GetAllAsync(); // Load customers from the repository
    }

    private async Task DeleteCustomerAsync(Customer customer)
    {
        await Repository.DeleteAsync(customer.Id);
        customers = await Repository.GetAllAsync(); // Refresh the list after deletion
    }


    private async Task SearchCustomersAsync(string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            customers = await Repository.GetAllAsync(); // Load all customers if search text is empty
        }
        else
        {
            customers = await Repository.GetByTextAsync(searchText); // Implement a search method in your repository
        }

    }

}

