
<table class="table table-striped table-bordered table-@Mode">

    <thead>
       @HeaderTemplate
    </thead>
    <tbody>        
        @foreach (var customer in Customers)
        {
            @RowTemplate(customer)
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="2">Total Customers: @Customers.Count()</td>
        </tr>
    </tfoot>


</table>


<button class="btn btn-secondary" @onclick='() => Mode = Mode == "light" ? "dark" : "light"'>Toggle Mode</button>

@code {


    [Parameter, EditorRequired]
    public IEnumerable<Customer> Customers { get; set; }

    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<Customer> RowTemplate { get; set; }

    private string Mode { get; set; } = "light";

}
